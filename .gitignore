# ===== Secrets / local config (NEVER commit real credentials) =====
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
*-secret.yml
secrets/
scripts/secret-expressions.txt

# ===== Build output =====
target/
out/
/build/
*.class

# ===== Node / frontend =====
node_modules/
dist/

# ===== Python tooling =====
__pycache__/
*.pyc

# ===== AI tool local data =====
.workbuddy-ai/
.claude/settings.local.json

# 本地脚本默认不纳入版本管理（scripts/secret-expressions.txt 见上方显式忽略）。
# 例外：Agent 前端交互验证脚本是可复现的交付材料，随仓库一起维护。
scripts/*
!scripts/agent-ui-verify.cjs
