# =============================================================================
# vibe-music-server 环境变量模板
#
# 用法：
#   1) 复制本文件为同目录下的 .env
#   2) 在 .env 中填入真实值（.env 已被 .gitignore 忽略，不会被提交）
#
# 安全要求：
#   - 严禁把真实密钥写进本文件或任何被 Git 跟踪的文件
#   - 严禁把 .env 提交、截图、粘贴到聊天工具或 Issue 中
#   - 密钥一旦泄露，立即在服务商控制台吊销并重新生成
# =============================================================================

# ---- MySQL ----
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- 邮件（QQ 邮箱 SMTP 授权码，不是登录密码）----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- MinIO 对象存储 ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- JWT 签名密钥（生产必填；至少 32 字节随机值）----
JWT_SECRET=

# ---- 首位管理员初始化（仅首次受控初始化使用）----
ADMIN_INIT_USERNAME=
ADMIN_INIT_PASSWORD=

# ---- 阿里云百炼 DashScope（LangChain4j / 通义千问）----
DASHSCOPE_API_KEY=
