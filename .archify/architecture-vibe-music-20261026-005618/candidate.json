  "cards": [
    {
      "dot": "cyan",
      "title": "请求链路",
      "items": [
        "两个 SPA 同源代理转发到 :8080，规避跨域与 Cookie SameSite 问题",
        "游客可匿名浏览曲库；登录后 JWT 有效期 6 小时，存 Redis db1 白名单",
        "ROLE_ADMIN / ROLE_USER 按路径前缀授权，公开管理员注册端点已下线"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 对话链路",
      "items": [
        "/ai/chat/stream 以 SSE 推送 start→tool→confirm→token→done 事件",
        "创建歌单两段式：模型只出待确认预览，用户确认并重新校验后才写入",
        "对话记忆存 MySQL（窗口 20 条）；温度 0.3、单次输出 ≤512 token"
      ]
    },
    {
      "dot": "emerald",
      "title": "存储与治理",
      "items": [
        "Spring Cache 走 Redis，注解缓存 TTL 10 分钟，与拦截器共用 db1",
        "删除媒体先登记任务表，worker 核对 7 类引用列，无引用才删对象",
        "30s 定时任务兜底重试；可靠性只依赖数据库，不依赖回调"
      ]
    },
    {
      "dot": "rose",
      "title": "外部服务与可观测性",
      "items": [
        "验证码邮件经 QQ 邮箱 SMTP（SSL :465）发送",
        "歌词补全抓取 QQ 音乐接口，带匹配得分阈值与总开关",
        "管理端内置 AI 调用追踪页（traces），观测每次模型与工具调用"
      ]
    }
  ]
}
